// مِرسَاة - مخطط قاعدة البيانات
// يحتوي على 7 وحدات: العملاء، الأبحاث، الإبداع، المتجر، الإعلانات، التحليلات، الأتمتة

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== الوحدة 1: Onboarding ====================

model Client {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?
  storeUrl        String?
  niche           String?
  brandColor      String?
  brandLogo       String?
  status          String    @default("onboarding") // onboarding, active, paused, churned
  readinessScore  Int       @default(0) // 0-100
  monthlyBudget   Float?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  brandAssets     BrandAsset[]
  personas        Persona[]
  competitors     Competitor[]
  contents        Content[]
  products        Product[]
  campaigns       Campaign[]
  metrics         Metric[]
  workflows       Workflow[]
  tasks           Task[]
  contracts       Contract[]
}

model BrandAsset {
  id        String   @id @default(cuid())
  clientId  String
  type      String   // logo, image, video, document
  name      String
  url       String
  quality   String?  // low, medium, high
  sizeKb    Int?
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Contract {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  content     String
  status      String   @default("draft") // draft, sent, signed, cancelled
  signedAt    DateTime?
  value       Float?
  currency    String?  @default("SAR")
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ==================== الوحدة 2: Intelligence Lab ====================

model Competitor {
  id            String   @id @default(cuid())
  clientId      String
  name          String
  url           String?
  facebookPage  String?
  tiktokHandle  String?
  instagramHandle String?
  notes         String?
  strengthScore Int?     // 0-100
  createdAt     DateTime @default(now())
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ads           CompetitorAd[]
}

model CompetitorAd {
  id            String   @id @default(cuid())
  competitorId  String
  platform      String   // meta, tiktok, google
  format        String?  // image, video, carousel
  copyHeadline  String?
  copyBody      String?
  ctaText       String?
  thumbnailUrl  String?
  daysRunning   Int?
  estimatedSpend Float?
  analysis      String?  // AI-generated analysis
  createdAt     DateTime @default(now())
  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
}

model Persona {
  id           String   @id @default(cuid())
  clientId     String
  name         String
  ageRange     String?
  gender       String?
  location     String?
  interests    String?  // JSON string
  painPoints   String?  // JSON string
  aspirations  String?  // JSON string
  buyingTriggers String? // JSON string
  channels     String?  // JSON string
  createdAt    DateTime @default(now())
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Trend {
  id          String   @id @default(cuid())
  niche       String
  platform    String
  hashtag     String?
  sound       String?
  format      String?
  reach       Int?
  velocity    Int?     // growth rate
  notes       String?
  detectedAt  DateTime @default(now())
}

// ==================== الوحدة 3: Creative Studio ====================

model Template {
  id          String   @id @default(cuid())
  name        String
  category    String   // image, video, copy, landing
  platform    String?  // meta, tiktok, google, all
  thumbnail   String?
  content     String   // JSON with template structure
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Content {
  id          String   @id @default(cuid())
  clientId    String
  type        String   // image, video, copy, carousel
  platform    String?
  title       String
  body        String?
  mediaUrl    String?
  cta         String?
  status      String   @default("draft") // draft, in_review, approved, rejected, live
  aiGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ==================== الوحدة 4: Store Wizard ====================

model Product {
  id            String   @id @default(cuid())
  clientId      String
  name          String
  sku           String?
  price         Float
  cost          Float?
  currency      String?  @default("SAR")
  imageUrl      String?
  description   String?
  stock         Int      @default(0)
  category      String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model StoreConnection {
  id          String   @id @default(cuid())
  clientId    String   @unique
  platform    String   // shopify, salla, zid, woo
  storeUrl    String
  apiKey      String?
  webhookUrl  String?
  pixelStatus String?  // json: {meta, tiktok, google, ga4}
  lastSync    DateTime?
  createdAt   DateTime @default(now())
}

// ==================== الوحدة 5: Ad Control Room ====================

model Campaign {
  id            String   @id @default(cuid())
  clientId      String
  name          String
  platform      String   // meta, tiktok, google
  objective     String?  // awareness, traffic, conversion, leads
  status        String   @default("draft") // draft, active, paused, completed
  dailyBudget   Float
  totalBudget   Float?
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime @default(now())
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ads           Ad[]
}

model Ad {
  id            String   @id @default(cuid())
  campaignId    String
  name          String
  format        String   // image, video, carousel
  copy          String?
  cta           String?
  mediaUrl      String?
  targetAudience String?  // JSON
  status        String   @default("draft") // draft, in_review, active, rejected, paused
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  spend         Float    @default(0)
  conversions   Int      @default(0)
  revenue       Float    @default(0)
  roas          Float    @default(0)
  createdAt     DateTime @default(now())
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ==================== الوحدة 6: Analytics Hub ====================

model Metric {
  id          String   @id @default(cuid())
  clientId    String
  date        DateTime
  platform    String
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Float    @default(0)
  conversions Int      @default(0)
  revenue     Float    @default(0)
  ctr         Float    @default(0)
  cpc         Float    @default(0)
  cpa         Float    @default(0)
  roas        Float    @default(0)
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
}

model Insight {
  id          String   @id @default(cuid())
  clientId    String?
  type        String   // opportunity, warning, achievement, info
  title       String
  body        String
  priority    String   @default("medium") // low, medium, high, critical
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ==================== الوحدة 7: Automation Engine ====================

model Workflow {
  id          String   @id @default(cuid())
  clientId    String?
  name        String
  trigger     String   // on_client_create, on_low_roas, on_daily_report, etc
  steps       String   // JSON array of steps
  isActive    Boolean  @default(true)
  lastRun     DateTime?
  createdAt   DateTime @default(now())
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Task {
  id          String   @id @default(cuid())
  clientId    String?
  title       String
  description String?
  status      String   @default("pending") // pending, in_progress, done, blocked
  priority    String   @default("medium")
  dueDate     DateTime?
  assignee    String?
  category    String?  // onboarding, creative, ads, analytics, etc
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Report {
  id          String   @id @default(cuid())
  clientId    String?
  period      String   // daily, weekly, monthly
  startDate   DateTime
  endDate     DateTime
  summary     String?  // JSON
  pdfUrl      String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
}

// ==================== إعدادات النظام ====================

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
