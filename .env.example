# قاعدة البيانات (SQLite مجاني)
DATABASE_URL="file:./dev.db"

# مزود الذكاء الاصطناعي (اختر واحد أو كلاهما)
# 1) Ollama محلي (مجاني تماماً، يحتاج تنصيب على جهازك)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# 2) Hugging Face Inference API (مجاني - 30,000 طلب/شهر)
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL="mistralai/Mistral-7B-Instruct-v0.3"

# 3) OpenRouter (مجاني - بعض الموديلات)
OPENROUTER_API_KEY=""

# إعدادات عامة
NEXT_PUBLIC_APP_NAME="مِرسَاة"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
